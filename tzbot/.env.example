# @BotFather dan olingan YANGI bot tokeni (tug'ilgan kunlar botidan alohida bot)
BOT_TOKEN=your_bot_token_here

# Vaqt mintaqasi — deadline va eslatmalar shu bo'yicha hisoblanadi
TIMEZONE=Asia/Tashkent

# SQLite bazasi fayli
DB_PATH=tasks.db

# Xabarlarda ko'rinadigan jamoa nomi
TEAM_NAME=Deha

# Bitta dizayner bir vaqtda nechta ishni parallel boshlay oladi
WIP_LIMIT=2

# Dizaynerlarning username'lari, vergul bilan (@ belgisiz).
# Bo'sh qoldirilsa — /boshladim va /tayyor ni hamma ishlatishi mumkin.
DESIGNER_USERNAMES=

# Kunlik navbat xulosasi yuboriladigan vaqt
DIGEST_HOUR=9
DIGEST_MINUTE=30

# Deadline'ga necha soat qolganda "hali boshlanmagan" deb eslatilsin
REMINDER_LEAD_HOURS=2
