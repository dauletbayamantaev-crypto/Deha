# @BotFather dan olingan YANGI bot tokeni (tug'ilgan kunlar botidan alohida bot)
BOT_TOKEN=your_bot_token_here

# Vaqt mintaqasi — deadline va eslatmalar shu bo'yicha hisoblanadi
TIMEZONE=Asia/Tashkent

# SQLite bazasi fayli
DB_PATH=tasks.db

# Kunlik xulosa yuboriladigan vaqt
DIGEST_HOUR=9
DIGEST_MINUTE=30

# Deadline'ga necha soat qolganda eslatilsin
REMINDER_LEAD_HOURS=2

# Hisobotda "shoshilinch" deb sanaladigan muddat (soat)
RUSH_HOURS=4
